    "@fastify/jwt": "^10.0.0",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/session": "^11.1.1",
    "better-sqlite3": "^12.5.0",
    "chalk": "^5.6.2",
    "node-vault": "^0.10.9",
    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/request": "^2.48.13",
    "@types/node": "^22.10.10",
    "typescript": "^5.8.2"
