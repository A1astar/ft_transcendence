{
  "name": "@ft_transcendence/authentication",
  "version": "1.0.0",
  "private": true,
  "description": "Authentication service of transcendence app.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "mkdir -p database && tsc",
    "clean": "rm -rf dist",
